# Copy this file to .env and fill in your own values.
#   Windows:  copy .env.example .env
#
# Get the connection string from MongoDB Atlas:
#   Cluster -> Connect -> Drivers -> Node.js
# Then replace <username> and <password> with your database user credentials.

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/instalite?retryWrites=true&w=majority&appName=Cluster0
